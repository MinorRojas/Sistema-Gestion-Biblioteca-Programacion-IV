@model CatalogoViewModel
@{ViewData["Title"]="Catálogo";}
<div class="hero mb-4"><h1>Catálogo de libros</h1><p>Busque por título o autor y filtre por categoría.</p></div>
<form method="get" class="row g-2 mb-4"><div class="col-md-6"><input asp-for="Busqueda" class="form-control" placeholder="Título o autor"/></div><div class="col-md-4"><select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select"><option value="">Todas las categorías</option></select></div><div class="col-md-2 d-grid"><button class="btn btn-primary">Buscar</button></div></form>
<div class="row g-4">@foreach(var libro in Model.Libros){<div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><span class="badge text-bg-secondary">@libro.Categoria</span><h5 class="mt-3">@libro.Titulo</h5><p class="text-muted">@libro.Autor</p><p><strong>@(libro.Disponible ? $"Disponible ({libro.EjemplaresDisponibles})" : "No disponible")</strong></p><a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@libro.Id">Ver detalle</a></div></div></div>}@if(Model.Libros.Count==0){<div class="col-12"><div class="alert alert-info">No se encontraron libros.</div></div>}</div>
