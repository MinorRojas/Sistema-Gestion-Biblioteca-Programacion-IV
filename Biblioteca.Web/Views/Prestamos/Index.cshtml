@model List<Biblioteca.Web.Models.ViewModels.PrestamoListItemViewModel>
@{
    ViewData["Title"] = "Préstamos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Historial de préstamos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo préstamo</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Libro</th><th>Usuario</th><th>Fecha préstamo</th><th>Devolución esperada</th><th>Estado</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.LibroTitulo</td>
                <td>@p.UsuarioCorreo</td>
                <td>@p.FechaPrestamo.ToShortDateString()</td>
                <td>@p.FechaDevolucionEsperada.ToShortDateString()</td>
                <td>@(p.Devuelto ? $"Devuelto el {p.FechaDevolucionReal!.Value.ToShortDateString()}" : "Pendiente")
                    @if (p.DiasAtraso.HasValue)
                    {
                        <span class="badge bg-danger ms-1">Atraso: @p.DiasAtraso día(s)</span>
                    }
                </td>
                <td class="text-end">
                    @if (!p.Devuelto)
                    {
                        <form asp-action="Devolver" asp-route-id="@p.Id" method="post"
                              class="d-inline d-flex align-items-center gap-1 justify-content-end"
                              onsubmit="return confirm('¿Desea registrar la devolución de este libro?');">
                            <input type="date" name="fechaDevolucion" class="form-control form-control-sm" style="width: 150px;"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            <button class="btn btn-sm btn-outline-success">Registrar devolución</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>