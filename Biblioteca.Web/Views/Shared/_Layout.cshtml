<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - Biblioteca</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css"/></head><body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand" asp-controller="Catalogo" asp-action="Index">Biblioteca</a><div class="navbar-nav"><a class="nav-link" asp-controller="Catalogo" asp-action="Index">Catálogo</a>@if(User.IsInRole("Admin")){<a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a><a class="nav-link" asp-controller="Autores" asp-action="Index">Autores</a><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorías</a><a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a>}</div><div class="ms-auto d-flex align-items-center gap-2">
    @if(User.Identity?.IsAuthenticated==true)
    {
        <span class="text-white small">@User.Identity.Name</span>
        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
            <button class="btn btn-outline-light btn-sm">Cerrar sesión</button>
        </form>
    }
    else
    {
        <a class="btn btn-warning btn-sm" asp-area="Identity" asp-page="/Account/Login">Administración</a>
    }
</div></div></nav>
<main class="container py-4">@if(TempData["Mensaje"] is string m){<div class="alert alert-success">@m</div>}@if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}@RenderBody()</main><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>