@model Biblioteca.Web.Models.Entities.Libro
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Isbn" class="form-label">ISBN</label><input asp-for="Isbn" class="form-control" /><span asp-validation-for="Isbn" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Sinopsis" class="form-label"></label><textarea asp-for="Sinopsis" class="form-control"></textarea><span asp-validation-for="Sinopsis" class="text-danger"></span></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="AnioPublicacion" class="form-label"></label><input asp-for="AnioPublicacion" class="form-control" type="number" /><span asp-validation-for="AnioPublicacion" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="CantidadEjemplares" class="form-label"></label><input asp-for="CantidadEjemplares" class="form-control" type="number" min="0" /><span asp-validation-for="CantidadEjemplares" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="EjemplaresDisponibles" class="form-label"></label><input asp-for="EjemplaresDisponibles" class="form-control" type="number" min="0" /><span asp-validation-for="EjemplaresDisponibles" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="AutorId" class="form-label">Autor</label><select asp-for="AutorId" class="form-select" asp-items="@(new SelectList(ViewBag.Autores, "Id", "Nombre"))"><option value="">Seleccione un autor</option></select><span asp-validation-for="AutorId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CategoriaId" class="form-label">Categoría</label><select asp-for="CategoriaId" class="form-select" asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre"))"><option value="">Seleccione una categoría</option></select><span asp-validation-for="CategoriaId" class="text-danger"></span></div>
