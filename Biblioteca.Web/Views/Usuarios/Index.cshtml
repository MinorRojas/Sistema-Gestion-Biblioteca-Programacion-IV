@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{ ViewData["Title"] = "Gestión de usuarios"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Gestión de usuarios</h1><a asp-action="Create" class="btn btn-primary">Crear usuario</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-10"><input name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por correo" /></div><div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Buscar</button></div></form>
<table class="table table-striped table-bordered"><thead><tr><th>Correo</th><th>Usuario</th><th>Acciones</th></tr></thead><tbody>
@foreach (var usuario in Model) { <tr><td>@usuario.Email</td><td>@usuario.UserName</td><td><a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-info btn-sm">Ver</a> <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-warning btn-sm">Editar</a> <form asp-action="Delete" asp-route-id="@usuario.Id" method="post" class="d-inline"><button class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar este usuario?')">Eliminar</button></form></td></tr> }
</tbody></table>
