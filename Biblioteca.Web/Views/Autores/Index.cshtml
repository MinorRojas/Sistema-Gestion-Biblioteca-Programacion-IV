@model IEnumerable<Autor>
@{ViewData["Title"]="Autores";}<div class="d-flex justify-content-between align-items-center mb-3"><h1>Gestión de autores</h1><a asp-action="Create" class="btn btn-primary">Nuevo autor</a></div><table class="table table-striped"><thead><tr><th>Nombre</th><th>Biografía</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Nombre</td><td>@a.Biografia</td><td class="text-end"><a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr>}</tbody></table>
